# PostgreSQL connection string
DATABASE_URL=postgres://internly:internly@localhost:5432/internly

# Secret used to sign session cookies (generate with: openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-string

# Public base URL of the site (used in emails and share links)
APP_URL=http://localhost:3000

# Where uploaded files (CVs, logos, images) are stored on disk
UPLOAD_DIR=./uploads

# Optional SMTP settings. When SMTP_HOST is empty, emails are printed to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Internly <no-reply@internly.ng>"

# Initial admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@internly.ng
SEED_ADMIN_PASSWORD=Admin@12345

# Secret for the alert digest endpoint (GET /api/cron/alerts with "Authorization: Bearer <secret>")
CRON_SECRET=change-me
